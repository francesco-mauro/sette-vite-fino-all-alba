// La configurazione di Cloudflare Workers: dice a Wrangler cosa pubblicare e con quale nome.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Il nome del Worker. Finisce nell'indirizzo pubblico: <nome>.<sottodominio dell'account>.workers.dev
  "name": "sette-vite-fino-all-alba",
  // Le regole di Cloudflare con cui gira il Worker, fissate a una data:
  // così un loro aggiornamento non cambia da solo il comportamento del gioco.
  "compatibility_date": "2026-11-03",
  // Il codice sul server: risponde alle rotte /api (worker/index.ts).
  "main": "./worker/index.ts",
  // I file statici: la cartella che prepara `npm run build`.
  "assets": {
    "directory": "./dist",
    // Il Worker parte solo per /api/*. Tutto il resto lo serve Cloudflare direttamente dai file,
    // come prima: più veloce, e le richieste dei file non contano come esecuzioni del Worker.
    "run_worker_first": ["/api/*"]
  }
}
